# Production settings for deploy/compose.prod.yml. Copy to .env.production (never commit it)
# and replace every value. `SAQ_ENV=prod` makes every process refuse to start if something
# required is missing or unsafe (apps/api/settings.py::production_problems).

# --- Public address (TLS certificates are obtained automatically for this name) ---
SAQ_DOMAIN=qa.example.com
PUBLIC_URL=https://qa.example.com
# Runners connect here with client certificates (mTLS); CA that signed the runner certs:
SAQ_RUNNER_DOMAIN=qa.example.com
SAQ_RUNNER_PORT=8443
RUNNER_CA_FILE=./runner-ca.pem

# --- Database / Redis passwords (generate: openssl rand -base64 32) ---
POSTGRES_PASSWORD=change-me
SAQ_APP_DB_PASSWORD=change-me
SAQ_WORKER_DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- Signing key for sessions: Ed25519 PEM on ONE line with \n escapes, in single quotes ---
# JWT_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----'
# openssl genpkey -algorithm ed25519
JWT_PRIVATE_KEY=

# --- Object storage for evidence and reports: your own S3 (versioning recommended) ---
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=smart-qa-evidence
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Models (docs/21): local-only | external-redacted | external-code ---
SAQ_MODEL_POLICY=external-redacted
SAQ_DEFAULT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
LOCAL_MODEL_URL=
# USD per million tokens for SAQ_DEFAULT_MODEL; copy from the provider's price page.
MODEL_PRICE_INPUT_PER_MTOK=
MODEL_PRICE_OUTPUT_PER_MTOK=
MODEL_PRICE_CACHE_READ_PER_MTOK=
SAQ_BUDGET_MONTHLY_USD=50

# --- Optional integrations ---
GITHUB_TOKEN=
GIT_READ_TOKEN=
BREACH_CHECK_MODE=off
SAQ_TELEMETRY=off
LOG_LEVEL=info
API_WORKERS=2
WORKER_REPLICAS=1

# --- Images (from the release workflow) ---
SAQ_IMAGE_PREFIX=ghcr.io/bushra2305341010-afk/smart-qa
SAQ_VERSION=latest

# --- Optional on-host runner (--profile runner) ---
SAQ_RUNNER_TOKEN=
SAQ_VAULT_KEY=
