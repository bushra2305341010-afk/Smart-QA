# Copy to .env and fill in. Never commit .env (see docs/15-setup-and-initialization.md §4).
SAQ_ENV=dev
# Runtime role (DML only, row-level security applies). Migrations use the owner role.
DATABASE_URL=postgresql+psycopg://saq_app:saq_dev_password@localhost:5432/saq
MIGRATION_DATABASE_URL=postgresql+psycopg://saq_migrator:saq_dev_password@localhost:5432/saq
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=evidence
S3_ACCESS_KEY=saq_s3
S3_SECRET_KEY=saq_s3_dev_password

# Model policy: local-only | external-redacted | external-code (docs/21 §B3)
SAQ_MODEL_POLICY=external-redacted
SAQ_DEFAULT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Local model (OpenAI-compatible server: Ollama, llama.cpp, vLLM, LM Studio). Required for local-only.
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=qwen3:8b

SAQ_TELEMETRY=off
SAQ_BUDGET_MONTHLY_USD=20
LOG_LEVEL=info
