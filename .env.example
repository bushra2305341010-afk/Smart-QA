# Copy to .env and fill in. Never commit .env (see docs/15-setup-and-initialization.md §4).
SAQ_ENV=dev
# Runtime role (DML only, row-level security applies). Migrations use the owner role.
DATABASE_URL=postgresql+psycopg://saq_app:saq_dev_password@localhost:5432/saq
MIGRATION_DATABASE_URL=postgresql+psycopg://saq_migrator:saq_dev_password@localhost:5432/saq
# System processes (orchestrator relay/recovery) log in as saq_worker (ADR-012).
WORKER_DATABASE_URL=postgresql+psycopg://saq_worker:saq_dev_password@localhost:5432/saq
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=evidence
S3_ACCESS_KEY=saq_s3
S3_SECRET_KEY=saq_s3_dev_password

# Model policy: local-only | external-redacted | external-code (docs/21 §B3)
SAQ_MODEL_POLICY=external-redacted
SAQ_DEFAULT_MODEL=claude-opus-5-5
# USD per million tokens for SAQ_DEFAULT_MODEL (required unless local-only). Check the current price page.
MODEL_PRICE_INPUT_PER_MTOK=
MODEL_PRICE_OUTPUT_PER_MTOK=
MODEL_PRICE_CACHE_READ_PER_MTOK=
ANTHROPIC_API_KEY=
# Local model (OpenAI-compatible server: Ollama, llama.cpp, vLLM, LM Studio). Required for local-only.
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=qwen3:8b
# Embeddings for retrieval (T-204): internal OpenAI-compatible server, 1024-dim model.
EMBEDDING_URL=
EMBEDDING_MODEL=bge-m3

# AES-256-GCM key for secrets at rest (TOTP): 32 random bytes, base64.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SAQ_ENCRYPTION_KEY=
# Ed25519 private key (PEM) for access tokens. Required when SAQ_ENV=prod; dev/test use a random one.
# Generate: openssl genpkey -algorithm ed25519
JWT_PRIVATE_KEY=

# Read-only token for private repository import (T-202); used only by the worker.
GIT_READ_TOKEN=

# Bug filing (Gate 4 → report stage). Project setting: {"tracker": {"kind": "github", "repo": "owner/name"}}
GITHUB_TOKEN=

# Breached-password check: off | online (k-anonymity, 5-char hash prefix) | offline (BREACH_HASH_FILE)
BREACH_CHECK_MODE=off
BREACH_HASH_FILE=

# Rate limits (docs/06 §1). Use redis when running more than one API replica.
RATE_LIMIT_BACKEND=memory

SAQ_TELEMETRY=off
SAQ_BUDGET_MONTHLY_USD=20
LOG_LEVEL=info
